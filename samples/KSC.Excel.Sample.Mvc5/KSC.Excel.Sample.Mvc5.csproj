<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ASP.NET MVC 5 (System.Web) sample for .NET Framework 4.8.
    SDK-style class library whose output goes to .\bin, so the folder itself is a runnable web site:
      "C:\Program Files\IIS Express\iisexpress.exe" /path:<this folder> /port:5290
    (or point IIS at this folder). Global.asax + Views + web.config are plain files next to it.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <RootNamespace>KSC.Excel.Sample.Mvc5</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <PackageReference Include="Microsoft.AspNet.Mvc" />
    <ProjectReference Include="..\..\src\KSC.Excel.Mvc\KSC.Excel.Mvc.csproj" />
    <ProjectReference Include="..\..\src\KSC.Excel.Pdf\KSC.Excel.Pdf.csproj" Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\KSC.Excel.Pdf\KSC.Excel.Pdf.csproj')" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Global.asax;web.config;Views\**;ExcelTemplates\**" />
  </ItemGroup>


  <!-- PDF is optional: when the KSC.Excel.Pdf project sits next to this one it is referenced and KXL_PDF is defined -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\src\KSC.Excel.Pdf\KSC.Excel.Pdf.csproj')">
    <DefineConstants>$(DefineConstants);KXL_PDF</DefineConstants>
  </PropertyGroup>

</Project>
