<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <OutputType>WinExe</OutputType>
    <!-- one app, two runtimes: modern Windows (.NET 10) and .NET Framework 4.8 machines (no .NET install needed there) -->
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KSC.Excel.Designer</AssemblyName>
    <RootNamespace>KSC.Excel.Designer.Windows</RootNamespace>
    <Version>1.0.0</Version>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Description>KSC Excel Designer - desktop (Windows) application for designing Excel/PDF report templates.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- the WebView2 native loader is picked by process bitness: run as 64-bit on 64-bit Windows -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Windows.Forms" />   <!-- FolderBrowserDialog (OpenFolderDialog needs .NET 8+) -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KSC.Excel\KSC.Excel.csproj" />
    <ProjectReference Include="..\KSC.Excel.Pdf\KSC.Excel.Pdf.csproj" Condition="Exists('$(MSBuildThisFileDirectory)..\KSC.Excel.Pdf\KSC.Excel.Pdf.csproj')" />
  </ItemGroup>


  <!-- PDF is optional: when the KSC.Excel.Pdf project sits next to this one it is referenced and KXL_PDF is defined -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\KSC.Excel.Pdf\KSC.Excel.Pdf.csproj')">
    <DefineConstants>$(DefineConstants);KXL_PDF</DefineConstants>
  </PropertyGroup>

</Project>
