<Window x:Class="KSC.Excel.Designer.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="طراح قالب اکسل - KSC" Width="1440" Height="880" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Tahoma">
    <DockPanel>
        <Menu DockPanel.Dock="Top" FlowDirection="RightToLeft" Padding="4,2">
            <MenuItem Header="_فایل">
                <MenuItem Header="قالب جدید" Click="OnNew" />
                <MenuItem Header="باز کردن فایل قالب (JSON)…" Click="OnOpenFile" />
                <MenuItem Header="ذخیره‌ی قالب (در پوشه‌ی قالب‌ها)" Click="OnSave" />
                <MenuItem Header="ذخیره به‌عنوان فایل JSON…" Click="OnSaveAsFile" />
                <MenuItem Header="ورود از فایل Excel (xlsx)…" Click="OnImportXlsx" />
                <Separator />
                <MenuItem Header="خروجی Excel با داده‌ی نمونه…" Click="OnExportXlsx" />
                <MenuItem Header="خروجی PDF با داده‌ی نمونه…" Click="OnExportPdf" />
                <Separator />
                <MenuItem Header="انتخاب پوشه‌ی قالب‌ها…" Click="OnChooseFolder" />
                <MenuItem Header="باز کردن پوشه‌ی قالب‌ها در Explorer" Click="OnShowFolder" />
                <Separator />
                <MenuItem Header="خروج" Click="OnExit" InputGestureText="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_نمایش">
                <MenuItem Header="بارگذاری مجدد طراح" Click="OnReload" InputGestureText="F5" />
                <MenuItem Header="ابزار توسعه (DevTools)" Click="OnDevTools" InputGestureText="F12" />
            </MenuItem>
            <MenuItem Header="_راهنما">
                <MenuItem Header="درباره‌ی برنامه" Click="OnAbout" />
            </MenuItem>
        </Menu>
        <StatusBar DockPanel.Dock="Bottom" FlowDirection="RightToLeft">
            <StatusBarItem><TextBlock x:Name="FolderText" /></StatusBarItem>
        </StatusBar>
        <wv2:WebView2 x:Name="Web" />
    </DockPanel>
</Window>
