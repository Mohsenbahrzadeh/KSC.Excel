<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Classic ASP.NET (System.Web) + MVC 5 -->
    <TargetFrameworks>net472;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>KSC.Excel.Mvc</RootNamespace>
    <Version>1.0.0</Version>
    <PackageTags>excel;xlsx;mvc5;netframework</PackageTags>
    <Description>.NET Framework (ASP.NET MVC 5 / System.Web) integration for KSC.Excel: designer handler, ExcelResult, Html.KscExcelViewer helper.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNet.Mvc" />
    <Reference Include="System.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KSC.Excel\KSC.Excel.csproj" />
  </ItemGroup>

</Project>
