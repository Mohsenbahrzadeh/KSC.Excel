<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0: usable from .NET Framework 4.6.1+ and every modern .NET -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>KSC.Excel</RootNamespace>
    <Version>1.0.0</Version>
    <PackageTags>excel;xlsx;report;template;designer;persian;rtl</PackageTags>
    <Description>KSC Excel: visual designer for Excel templates + a dependency-free XLSX engine. Design once, bind data, get a beautiful .xlsx - no spreadsheet library needed.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!-- The designer UI is embedded: no wwwroot, no CDN (works on an intranet). -->
  <ItemGroup>
    <EmbeddedResource Include="Designer\UI\**\*" LogicalName="KSC.Excel.UI.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
